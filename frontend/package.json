{
  "name": "docmind-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DocMind 工作台前端（Vite 多页构建，产物输出到 ../web）",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:node": "node --test \"tests/*.test.mjs\"",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src --ext .ts,.vue"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@google/model-viewer": "^4.3.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "codemirror": "^6.0.2",
    "html2canvas": "^1.4.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
